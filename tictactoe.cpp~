
#include <iostream>



//Function prototypes 
void choice(char Array[][3]);
void display( char Array[][3]);

int main()
{

	char Array[3][3] = { { '1','2','3'}, {'4', '5', '6'}, {'7', '8', '9'}}; //board array 


	//Title card 
	std::cout << "TIC TAC TOE\n";
	std::cout << "_____________________________________\n\n"; 



	//show start board
	display(Array);


	//start game
	choice(Array);



	//show ending board
	display(Array); 
	








	return 0; 
}




void choice(char Array[][3])

{

	std::cout << "Player 1 pick: " <<std::endl;

	char input1; 
	std::cin >>   input1; //read position 

	
	//search through the board 
	for (int i = 0; i < 3; ++i)
	{
		

		for (int j = 0; j < 3; ++j)
		{
			
			if (input1 == Array[i][j])// compare input to array 

			{

				Array[i][j] = 'X'; //assign x to array char
				
				
				
			}



		}



	}

	display(Array);


	std::cout << "Player 2 pick: " << std::endl;

	char input2;
	std::cin >> input2;


	//search through the board 

	for (int i = 0; i < 3; ++i)
	{


		for (int j = 0; j < 3; ++j)
		{

			if (input2 == Array[i][j])// compare input to array 

			{

				Array[i][j] = 'O';//assign O to array char



			}



		}

	

	}


	

}




void display(char Array[][3])
{



	

	for (int i = 0; i < 3; ++i)
	{

		for (int j = 0; j < 3; ++j)
		{
			std::cout << "|";
			std::cout << Array[i][j]; 
			
		
			std::cout << "|";

		}
		
		std::cout << std::endl;

	}



	
}
